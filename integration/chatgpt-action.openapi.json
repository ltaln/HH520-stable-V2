{
  "openapi": "3.1.0",
  "info": {
    "title": "HH520 Stable V2",
    "version": "1.5",
    "description": "10023s数据准备，GPT在ChatGPT对话中完成最终推理。"
  },
  "servers": [
    {
      "url": "https://REPLACE-WITH-YOUR-DEPLOYED-HOST"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/prepare": {
      "post": {
        "operationId": "preparePrediction",
        "summary": "准备指定日期的10023s结构化分析",
        "x-openai-isConsequential": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "description": "预测 YYYY-MM-DD 全部比赛"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "已排队，读取prepared接口",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      }
    },
    "/prepared/{date}": {
      "get": {
        "operationId": "getPreparedPrediction",
        "summary": "获取准备状态及每页最多10场分析",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "数据就绪；next_offset非空时继续获取",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Prepared"
                }
              }
            }
          },
          "202": {
            "description": "采集仍进行中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "result_path": {
            "type": "string"
          }
        }
      },
      "Prepared": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "captured_at": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "match_count": {
            "type": "integer"
          },
          "eligible_count": {
            "type": "integer"
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "prompt": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
